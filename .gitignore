# Third-party runtimes downloaded per-machine, not project source.
# Godot_v4.5.2-stable_win64.exe alone is 157MB, over GitHub's 100MB file limit.
# Install Godot 4.5.2 and Node yourself and point GODOT_EXE at the binary.
tools/

# macOS archive residue from unzipping the frontend bundle
__MACOSX/

# Python build artifacts
*.egg-info/
__pycache__/
*.py[cod]

# Local virtualenvs and tool caches
.venv/
.pytest_cache/
.ruff_cache/

# Editor/script backups
*.bak
*.bak-*

# Former standalone frontend repo history, kept locally only
walnut-world-frontend/frontend-repo-git-backup/
