# Third-party runtimes downloaded per-machine, not project source.
# setup-play.ps1 installs Godot 4.7.1 here; runtime binaries are not source.
tools/

# macOS archive residue from unzipping the frontend bundle
__MACOSX/

# Python build artifacts
*.egg-info/
__pycache__/
*.py[cod]

# Local virtualenvs and tool caches
.venv/
.pytest_cache/
.ruff_cache/

# Local diagnostic runs and process state (may contain private runtime settings).
.local-run/

# Editor/script backups
*.bak
*.bak-*

# Former standalone frontend repo history, kept locally only
walnut-world-frontend/frontend-repo-git-backup/

# Provider credentials and local configuration must stay outside Git.
.env
.env.*
!.env.example
*.key
.walnut-secrets/
