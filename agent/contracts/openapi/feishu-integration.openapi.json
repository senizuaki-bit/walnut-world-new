        "operationId": "createFeishuReportDraftJob",
        "summary": "Queue an evidence-grounded report draft",
        "description": "Queues asynchronous draft generation from explicit evidence references and an immutable template. The output is always DRAFT_ONLY and NOT_SENT; delivery or publication is outside this API and requires separate authorization.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/feishu/report-job-request.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Report draft job durably queued; no report has been sent.",
            "headers": {
              "Location": {
                "description": "Canonical job status resource.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              },
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/report-job.schema.json"
                }
              }
