        "operationId": "queryClassInsightsFromFeishu",
        "summary": "Read privacy-protected class aggregates",
        "description": "Returns aggregate-only class insights. Small cells are always suppressed and the response schema cannot contain learner identifiers. This is a read operation despite using POST for structured query criteria.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
