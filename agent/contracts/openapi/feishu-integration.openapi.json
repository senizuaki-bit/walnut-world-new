  },
  "components": {
    "securitySchemes": {
      "ServiceBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Short-lived integration token bound to tenant, actor, roles and audience. Production deployments should additionally enforce mTLS at the gateway."
      },
      "FeishuWebhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Lark-Signature",
        "description": "Feishu callback signature. It must be checked with timestamp and nonce over the exact raw body before parsing."
      }
    },
    "parameters": {
      "SchemaVersion": {
        "name": "X-Schema-Version",
        "in": "header",
        "required": true,
        "description": "Reject unsupported clients explicitly instead of coercing unknown payloads.",
        "schema": {
          "type": "string",
          "const": "1.0.0"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Opaque caller-generated key scoped to tenant and operation. The server stores the request hash and committed response. Repeating the same key and same payload returns the original response; reusing it with a different payload returns 409 IDEMPOTENCY_KEY_REUSED. Processing must not create duplicate candidates, decisions, jobs or receipts.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
        }
      },
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": true,
        "description": "Current HTTP-attempt request identifier. On first processing it must equal context.request_id. A byte-equivalent Idempotency-Key replay retains the original body context while this header uses a new attempt identifier.",
        "schema": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "TraceId": {
        "name": "X-Trace-Id",
        "in": "header",
        "required": true,
        "description": "Current HTTP-attempt trace identifier. On first processing it must equal context.trace_id. A byte-equivalent Idempotency-Key replay retains the original body context while this header uses a new attempt trace.",
        "schema": {
          "type": "string",
          "pattern": "^trace_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "LarkTimestamp": {
        "name": "X-Lark-Request-Timestamp",
        "in": "header",
        "required": true,
        "description": "Provider callback timestamp used for signature verification and clock-skew rejection.",
        "schema": {
          "type": "string",
          "pattern": "^[0-9]{10,16}$"
        }
      },
      "LarkNonce": {
        "name": "X-Lark-Request-Nonce",
        "in": "header",
        "required": true,
        "description": "Provider nonce. A timestamp/nonce/signature tuple is accepted at most once within the replay window.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "LarkSignature": {
        "name": "X-Lark-Signature",
        "in": "header",
        "required": true,
        "description": "Provider signature over the exact raw request body and callback metadata.",
        "schema": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        }
      },
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^job_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "ReleaseId": {
        "name": "release_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^rel_[A-Za-z0-9_-]{8,128}$"
        }
      },
      "EvidenceId": {
        "name": "evidence_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^evidence_[A-Za-z0-9_-]{8,128}$"
        }
      },
      "EvidencePurpose": {
        "name": "purpose",
        "in": "query",
        "required": true,
        "description": "Purpose binding used in authorization and immutable access audit.",
        "schema": {
          "type": "string",
          "enum": [
            "TEACHER_SUPPORT",
            "GUARDIAN_REPORT",
            "LEARNING_REVIEW",
            "SAFETY_INVESTIGATION"
          ]
        }
      }
    },
    "headers": {
      "RequestId": {
        "description": "Echoed request identifier.",
        "schema": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "TraceId": {
        "description": "End-to-end trace identifier.",
        "schema": {
          "type": "string",
          "pattern": "^trace_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "RetryAfter": {
        "description": "Seconds before the client may retry with the same Idempotency-Key.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      },
      "IdempotencyReplayed": {
        "description": "false on first acceptance and true when the original 202 receipt is replayed.",
        "schema": {
          "type": "string",
          "enum": ["false", "true"]
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "$ref": "../schemas/common/error-response.schema.json"
      },
      "RequestContext": {
        "$ref": "../schemas/common/request-context.schema.json"
      },
      "AsyncJob": {
        "$ref": "../schemas/common/async-job.schema.json"
      },
      "EvidenceRef": {
        "$ref": "../schemas/common/evidence-ref.schema.json"
      },
      "ContentRef": {
        "$ref": "../schemas/common/content-ref.schema.json"
      },
      "ActorRef": {
        "$ref": "../schemas/common/actor-ref.schema.json"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Malformed request, header/body identity mismatch, invalid schema or callback timestamp outside the allowed window.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status400"
            }
          }
        }
      },
      "InvalidSignature": {
        "description": "Missing or invalid callback signature or invalid verification token.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status401"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, expired or invalid integration identity.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status401"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated actor lacks the tenant, role, subject or purpose authorization.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status403"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource is absent or intentionally hidden from this actor.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status404"
            }
          }
        }
      },
      "Conflict": {
        "description": "X-Schema-Version is unsupported (SCHEMA_VERSION_UNSUPPORTED), an idempotency key was reused with a different payload, an expected revision is stale, an immutable decision conflicts with an existing record, or a callback nonce was replayed (FEISHU_REPLAY_DETECTED).",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status409"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Well-formed input rejected by content, approval, privacy or evidence policy.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status422"
            }
          }
        }
      },
      "RateLimited": {
        "description": "Rate limit reached. The client may retry only after Retry-After and with the same Idempotency-Key.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status429"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected invariant or internal failure. The response always carries request_id and trace_id; the failure must be logged and alerted rather than converted into a success response.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status500"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Required dependency is unavailable. Accepted work must remain queryable; clients retry with the same Idempotency-Key.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/RequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/TraceId" },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status503"
            }
          }
        }
      }
    }
  }
}
