{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Yaya Agent Feishu Integration API",
    "version": "1.0.0",
    "description": "Contract-first boundary between Feishu and the Yaya Agent platform. Feishu is an asynchronous collaboration adapter: it may submit immutable content candidates, record approval decisions, read authorized projections and create report drafts. It has no WorldEngine command surface and cannot directly activate live content."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same-origin integration gateway"
    }
  ],
  "tags": [
    {
      "name": "Feishu Webhooks",
      "description": "Signed provider callbacks with replay protection and explicit quarantine semantics."
    },
    {
      "name": "Content Collaboration",
      "description": "Candidate and approval workflows. Neither operation activates content or writes game world state."
    },
    {
      "name": "Learning Read Models",
      "description": "Purpose-bound, redacted, read-only learner and class projections."
    },
    {
      "name": "Reports",
      "description": "Asynchronous evidence-grounded report draft generation."
    },
    {
      "name": "Evidence",
      "description": "Read-only redacted evidence views."
    }
  ],
  "security": [
    {
      "ServiceBearer": []
    }
  ],
  "paths": {
    "/integrations/feishu/v1/webhooks": {
      "post": {
        "tags": [
          "Feishu Webhooks"
        ],
        "operationId": "receiveFeishuWebhook",
        "summary": "Verify and durably receive a Feishu callback",
        "description": "The gateway MUST validate X-Lark-Request-Timestamp, X-Lark-Request-Nonce and X-Lark-Signature against the exact raw HTTP body before JSON parsing, reject timestamps outside the configured skew window, and atomically persist the receipt before acknowledging. A known duplicate returns 200 with DUPLICATE. An authenticated but unsupported event returns 200 with QUARANTINED_UNSUPPORTED and raises an observable quarantine record; it is never silently discarded.",
        "security": [
          {
            "FeishuWebhookSignature": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/LarkTimestamp"
          },
          {
            "$ref": "#/components/parameters/LarkNonce"
          },
          {
            "$ref": "#/components/parameters/LarkSignature"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/feishu/webhook.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "URL verification challenge or durable event receipt. The receipt is explicit about accepted, duplicate or quarantined disposition.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/webhook-response.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/InvalidSignature"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "x-idempotency-scope": "tenant + operation + Idempotency-Key",
        "x-replay-key": "tenant_key + event_id",
        "x-world-write": "FORBIDDEN",
        "x-silent-discard": "FORBIDDEN"
      }
    },
    "/integrations/feishu/v1/content-releases": {
      "post": {
        "tags": [
          "Content Collaboration"
        ],
        "operationId": "createFeishuContentReleaseCandidate",
        "summary": "Create and validate an immutable content candidate",
        "description": "Creates a candidate from an exact Feishu document revision and queues schema, semantic, policy and automated validation. A 202 response returns authoritative candidate_revision=1 for later compare-and-set approval. It means only that a candidate was durably created and validation was queued, never that the candidate is active.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/feishu/content-release.schema.json"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Candidate recorded and validation queued; candidate_revision is the authoritative initial revision and activation_status is always NOT_ACTIVATED.",
            "headers": {
              "Location": {
                "description": "Canonical content release status resource.",
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              },
              "Idempotency-Replayed": {
                "$ref": "#/components/headers/IdempotencyReplayed"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/content-release-receipt.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "x-required-role": "content:submitter",
        "x-world-write": "FORBIDDEN",
        "x-direct-content-activation": "FORBIDDEN",
        "x-live-target": "FORBIDDEN"
      }
    },
    "/integrations/feishu/v1/content-releases/{release_id}": {
      "get": {
        "tags": [
          "Content Collaboration"
        ],
        "operationId": "getFeishuContentReleaseStatus",
        "summary": "Read content candidate validation and release status",
        "description": "Makes the authoritative candidate_revision and every asynchronous validation and canary outcome observable. This operation is read-only; activation_status may report a later internal activation or rollback, but no Feishu operation can change it.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/ReleaseId"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "responses": {
          "200": {
            "description": "Current authoritative candidate revision, validation, canary and activation observation with per-check status.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/content-release-status.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "x-read-only": true,
        "x-required-role": "content:read",
        "x-direct-content-activation": "FORBIDDEN",
        "x-world-write": "FORBIDDEN"
      }
    },
    "/integrations/feishu/v1/approval-decisions": {
      "post": {
        "tags": [
          "Content Collaboration"
        ],
        "operationId": "recordFeishuApprovalDecision",
        "summary": "Record an approval decision against an exact candidate revision",
        "description": "Atomically compares expected_candidate_revision with the current candidate revision and records an authenticated decision only on an exact match. APPROVE permits the candidate to continue into validation; it is not an activation command. Reusing an Idempotency-Key with a different payload returns 409 IDEMPOTENCY_KEY_REUSED. A stale expected_candidate_revision or conflicting approval-instance business decision returns 409 CONTENT_VERSION_MISMATCH. Neither failure changes candidate state.",
        "x-invariants": [
          "request.expected_candidate_revision == current candidate_revision",
          "a newly recorded decision sets response.candidate_revision == request.expected_candidate_revision + 1",
          "tenant_id + approval_instance_id identifies one immutable canonical business decision and receipt",
          "an identical canonical business decision returns the original receipt without another revision increment",
          "conflicting approval-instance reuse and stale decisions return CONTENT_VERSION_MISMATCH without mutation",
          "WORKFLOW_CLOSED rejects later approval instances for the candidate without mutation"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/feishu/approval-decision.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision durably recorded by compare-and-set; candidate_revision is the committed +1 revision and activation_status is always NOT_ACTIVATED.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/approval-decision-receipt.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "x-required-role": "content:approver",
        "x-world-write": "FORBIDDEN",
        "x-direct-content-activation": "FORBIDDEN"
      }
    },
    "/integrations/feishu/v1/learner-queries": {
      "post": {
        "tags": [
          "Learning Read Models"
        ],
        "operationId": "queryLearnerProjectionFromFeishu",
        "summary": "Read a purpose-bound learner projection",
        "description": "Returns only authorized fields from a derived learner projection. The request cannot write mastery, append evidence, modify policy or invoke a world command. Direct identifiers are excluded and data freshness is mandatory in the response.",
        "parameters": [
          {
            "$ref": "#/components/parameters/SchemaVersion"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/RequestId"
          },
          {
            "$ref": "#/components/parameters/TraceId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../schemas/feishu/learner-query.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redacted learner projection and explicit projection freshness.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              },
              "X-Trace-Id": {
                "$ref": "#/components/headers/TraceId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/feishu/learner-query-result.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "x-read-only": true,
        "x-required-role": "learner:read",
        "x-audit-access": true,
        "x-world-write": "FORBIDDEN",
        "x-learner-model-write": "FORBIDDEN"
      }
    },
    "/integrations/feishu/v1/class-insights": {
