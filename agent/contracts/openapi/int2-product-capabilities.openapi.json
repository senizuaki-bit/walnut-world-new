{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "YaYa INT2 Product Capabilities API",
    "version": "0.6.0",
    "description": "Additive read-only Product Gateway capability projection. Existing v0.4 and v0.5 contract bytes remain frozen.",
    "license": { "name": "Proprietary" }
  },
  "servers": [{ "url": "https://api.yaya.example" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [{ "name": "INT2 capabilities" }],
  "paths": {
    "/product-experience/v1/capabilities": {
      "get": {
        "tags": ["INT2 capabilities"],
        "operationId": "getInt2Capabilities",
        "summary": "Read staged INT2 capability gates and immutable minimum constraints",
        "x-invariants": [
          "This route remains GET-only and creates no Product, Agent, Draft, Build, World, Evidence or Learner side effect.",
          "A false feature flag keeps the corresponding mutation entry points unavailable.",
          "For UI_ACTION action_id=request_ai_patch, selection_id denotes the currently visible failed interaction_id; Backend resolves and validates its Draft/Build/Run/Evidence authority.",
          "Recovery-only clients may read this route but may not infer or issue a mutation from it."
        ],
        "parameters": [
          { "$ref": "game-api.openapi.json#/components/parameters/RequestId" },
          { "$ref": "game-api.openapi.json#/components/parameters/TraceId" },
          { "$ref": "game-api.openapi.json#/components/parameters/CorrelationId" },
          { "$ref": "game-api.openapi.json#/components/parameters/SchemaVersion" }
        ],
        "responses": {
          "200": {
            "description": "Current authenticated INT2 capability projection.",
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/product-experience/int2-capabilities.schema.json" }
              }
            }
          },
          "400": { "$ref": "game-api.openapi.json#/components/responses/BadRequest" },
          "401": { "$ref": "game-api.openapi.json#/components/responses/Unauthorized" },
          "403": { "$ref": "game-api.openapi.json#/components/responses/Forbidden" },
          "409": { "$ref": "game-api.openapi.json#/components/responses/Conflict" },
          "429": { "$ref": "game-api.openapi.json#/components/responses/RateLimited" },
          "500": { "$ref": "game-api.openapi.json#/components/responses/InternalError" },
          "503": { "$ref": "game-api.openapi.json#/components/responses/Unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  }
}
