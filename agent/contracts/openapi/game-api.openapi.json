    "/v1/client-events:batch": {
      "post": {
        "tags": ["Client events"],
        "operationId": "ingestClientEventBatch",
        "x-godot-operation": "upload_client_events",
        "summary": "Durably ingest an ordered client outbox batch",
        "description": "The client may delete local events only after the command reaches APPLIED. Duplicate event IDs are reported in the command result and do not create duplicate evidence.",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" },
          { "$ref": "#/components/parameters/TraceId" },
          { "$ref": "#/components/parameters/CorrelationId" },
          { "$ref": "#/components/parameters/SchemaVersion" },
