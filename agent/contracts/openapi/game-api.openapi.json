{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "芽芽家园 Game Contract API",
    "version": "1.0.0",
    "description": "Contract-first API between the Godot client and the authoritative game backend. A 202 response means accepted only; clients must query the returned command_id until a terminal state is observed.",
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.yaya.example",
      "description": "Environment-specific base URL"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Bootstrap" },
    { "name": "Skills" },
    { "name": "Agents" },
    { "name": "Commands" },
    { "name": "Runs" },
    { "name": "World" },
    { "name": "Client events" },
    { "name": "Evidence" }
  ],
  "x-contract-invariants": [
    "HTTP 202 means accepted, never applied.",
    "Every accepted write returns job_id, command_id, and trace_id.",
    "Every Game request supplies X-Request-Id, X-Trace-Id, X-Correlation-Id, and X-Schema-Version for the current HTTP attempt.",
    "Every Game response echoes the current HTTP attempt identity in X-Request-Id, X-Trace-Id, and X-Correlation-Id; persisted response request_context remains the immutable origin context.",
    "A retry reuses the original Idempotency-Key and byte-equivalent body.",
    "UNKNOWN is a terminal uncertainty state and must be reconciled by command_id, not retried with a new key.",
    "The UI treats only an APPLIED command with a WORLD_COMMIT receipt as a committed world mutation."
  ],
  "paths": {
    "/v1/bootstrap": {
      "get": {
        "tags": ["Bootstrap"],
        "operationId": "getGameBootstrap",
        "x-godot-operation": "get_bootstrap",
        "summary": "Get version-pinned client bootstrap data",
        "parameters": [
          { "$ref": "#/components/parameters/RequestId" },
          { "$ref": "#/components/parameters/TraceId" },
          { "$ref": "#/components/parameters/CorrelationId" },
          { "$ref": "#/components/parameters/SchemaVersion" }
        ],
        "responses": {
          "200": {
            "description": "Bootstrap data with authoritative world cursor",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
              "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
              "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "../schemas/game/bootstrap-response.schema.json" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
