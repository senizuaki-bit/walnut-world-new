  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Production profile: a short-lived signed JWT whose tenant, actor, roles and audience are verified by the gateway. Deterministic local Mock profile only: `<tenant_id>:<actor_id>`. Mock credentials MUST NOT be accepted outside local development or automated tests.",
        "x-development-profile": {
          "server": "http://127.0.0.1:8790",
          "loopback_host_aliases": ["127.0.0.1", "localhost"],
          "token_pattern": "^[A-Za-z0-9_-]{3,96}:[A-Za-z0-9_-]{3,128}$",
          "production_allowed": false
        }
      }
    },
    "parameters": {
      "RequestId": {
        "name": "X-Request-Id",
        "in": "header",
        "required": true,
        "description": "Identity of this HTTP attempt. A polling or idempotent replay attempt uses a new request id.",
        "schema": {
          "type": "string",
          "pattern": "^req_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "TraceId": {
        "name": "X-Trace-Id",
        "in": "header",
        "required": true,
        "description": "Trace identity of this HTTP attempt. It is distinct from an immutable resource origin trace and from the original trace retained in an idempotent 202 receipt.",
        "schema": {
          "type": "string",
          "pattern": "^trace_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": true,
        "description": "Correlation identity of this HTTP attempt. A later reconciliation request may use a different correlation id without mutating the resource origin context.",
        "schema": {
          "type": "string",
          "pattern": "^corr_[A-Za-z0-9_-]{8,96}$"
        }
      },
      "SchemaVersion": {
        "name": "X-Schema-Version",
        "in": "header",
        "required": true,
        "description": "Reject unsupported clients explicitly instead of coercing unknown payloads.",
        "schema": {
          "const": "1.0.0"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Reuse for byte-equivalent retries. Reusing the key with a different body returns 409.",
        "schema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{15,127}$"
        }
      },
      "BuildId": {
        "name": "build_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "SkillVersionId": {
        "name": "skill_version_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "ActivationId": {
        "name": "activation_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^activation_[A-Za-z0-9_-]{8,118}$"
        }
      },
      "SessionId": {
        "name": "session_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "CommandId": {
        "name": "command_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "../schemas/common/command-id.schema.json" }
      },
      "RunId": {
        "name": "run_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "WorldId": {
        "name": "world_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ResourceId" }
      },
      "EvidenceId": {
        "name": "evidence_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^evidence_[A-Za-z0-9_-]{8,128}$"
        }
      },
      "AfterSequence": {
        "name": "after_sequence",
        "in": "query",
        "required": true,
        "description": "Return events strictly after this last successfully applied sequence.",
        "schema": {
          "type": "integer",
          "minimum": 0
        }
      },
      "PageLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      }
    },
    "headers": {
      "ResponseRequestId": {
        "description": "Echoes the current HTTP attempt X-Request-Id.",
        "schema": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,96}$" }
      },
      "ResponseTraceId": {
        "description": "Echoes the current HTTP attempt X-Trace-Id.",
        "schema": { "type": "string", "pattern": "^trace_[A-Za-z0-9_-]{8,96}$" }
      },
      "ResponseCorrelationId": {
        "description": "Echoes the current HTTP attempt X-Correlation-Id.",
        "schema": { "type": "string", "pattern": "^corr_[A-Za-z0-9_-]{8,96}$" }
      },
      "IdempotencyReplayed": {
        "description": "false for the first durable acceptance; true when this response replays the original receipt for the same Idempotency-Key and body.",
        "schema": { "type": "string", "enum": ["false", "true"] }
      },
      "SnapshotEtag": {
        "description": "Strong validator derived from world_id, revision, and state_hash.",
        "schema": { "type": "string", "pattern": "^\"[A-Za-z0-9:_-]{8,200}\"$" }
      },
      "EvidenceEtag": {
        "description": "Immutable evidence content hash validator.",
        "schema": { "type": "string", "pattern": "^\"[a-f0-9]{64}\"$" }
      },
      "WorldRevision": {
        "description": "Authoritative world revision represented by the response.",
        "schema": { "type": "integer", "minimum": 0 }
      }
    },
    "responses": {
      "AcceptedJob": {
        "description": "Durably accepted for asynchronous processing; this is not an execution-success response. AcceptedGameJob.trace_id remains the original command trace, while X-Trace-Id identifies the current HTTP attempt.",
        "headers": {
          "Location": {
            "description": "Command reconciliation URL.",
            "schema": { "type": "string", "format": "uri-reference" }
          },
          "Retry-After": {
            "description": "Suggested minimum polling delay in seconds.",
            "schema": { "type": "integer", "minimum": 1 }
          },
          "Idempotency-Replayed": { "$ref": "#/components/headers/IdempotencyReplayed" },
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AcceptedGameJob" }
          }
        }
      },
      "BadRequest": { "$ref": "#/components/responses/Error400" },
      "Unauthorized": { "$ref": "#/components/responses/Error401" },
      "Forbidden": { "$ref": "#/components/responses/Error403" },
      "NotFound": { "$ref": "#/components/responses/Error404" },
      "Conflict": { "$ref": "#/components/responses/Error409" },
      "PayloadTooLarge": { "$ref": "#/components/responses/Error413" },
      "Unprocessable": { "$ref": "#/components/responses/Error422" },
      "RateLimited": { "$ref": "#/components/responses/Error429" },
      "InternalError": { "$ref": "#/components/responses/Error500" },
      "Unavailable": { "$ref": "#/components/responses/Error503" },
      "Error400": {
        "description": "Request contract or header validation failed.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status400" } } }
      },
      "Error401": {
        "description": "Authentication failed.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status401" } } }
      },
      "Error403": {
        "description": "The authenticated actor is not authorized.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status403" } } }
      },
      "Error404": {
        "description": "The requested resource is not visible or does not exist.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status404" } } }
      },
      "Error409": {
        "description": "Idempotency payload mismatch, stale revision, or sequence conflict.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status409" } } }
      },
      "Error413": {
        "description": "Payload exceeds the published bootstrap limit.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status413" } } }
      },
      "Error422": {
        "description": "The request is structurally valid but violates a domain or policy rule.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status422" } } }
      },
      "Error429": {
        "description": "Rate limit exceeded.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" },
          "Retry-After": {
            "description": "Minimum retry delay in seconds.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status429" } } }
      },
      "Error500": {
        "description": "Unexpected internal failure with a traceable error body.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status500" } } }
      },
      "Error503": {
        "description": "A required dependency is unavailable; retry only when error.retryable is true. UNKNOWN_COMMIT_STATE requires Location to equal /v1/commands/{body.command_id} so the durable result can be reconciled without issuing a new command.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/ResponseRequestId" },
          "X-Trace-Id": { "$ref": "#/components/headers/ResponseTraceId" },
          "X-Correlation-Id": { "$ref": "#/components/headers/ResponseCorrelationId" },
          "Location": {
            "description": "Required for UNKNOWN_COMMIT_STATE after durable acceptance and exactly /v1/commands/{body.command_id}; poll this URL instead of creating a new command.",
            "schema": { "type": "string", "format": "uri-reference" }
          },
          "Retry-After": {
            "description": "Suggested retry delay in seconds.",
            "schema": { "type": "integer", "minimum": 1 }
          }
        },
        "content": { "application/json": { "schema": { "$ref": "../schemas/common/error-responses-by-status.schema.json#/$defs/status503" } } }
      }
    },
    "schemas": {
      "AcceptedGameJob": {
        "$ref": "../schemas/game/accepted-game-job.schema.json"
      },
      "ResourceId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
      }
    }
  }
}
