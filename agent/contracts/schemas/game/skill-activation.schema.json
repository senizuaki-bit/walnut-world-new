{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/game/skill-activation.schema.json",
  "title": "Materialized skill activation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_context",
    "activation_id",
    "skill_id",
    "skill_version_id",
    "certification_id",
    "artifact_sha256",
    "activation_scope",
    "previous_registry_revision",
    "registry_revision",
    "activated_at"
  ],
  "properties": {
    "request_context": { "$ref": "../common/request-context.schema.json" },
    "activation_id": { "type": "string", "pattern": "^activation_[A-Za-z0-9_-]{8,118}$" },
    "skill_id": { "$ref": "#/$defs/identifier" },
    "skill_version_id": { "type": "string", "pattern": "^skillver_[A-Za-z0-9_-]{8,118}$" },
    "certification_id": { "type": "string", "pattern": "^cert_[A-Za-z0-9_-]{8,122}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "activation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_id", "agent_profile_id"],
      "properties": {
        "world_id": { "$ref": "#/$defs/identifier" },
        "agent_profile_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "previous_registry_revision": { "type": "integer", "minimum": 0 },
    "registry_revision": { "type": "integer", "minimum": 1 },
    "activated_at": { "type": "string", "format": "date-time" }
  },
  "x-invariants": [
    "registry_revision == previous_registry_revision + 1"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
