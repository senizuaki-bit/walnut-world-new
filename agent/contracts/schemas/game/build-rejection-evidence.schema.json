{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/game/build-rejection-evidence.schema.json",
  "title": "Immutable rejected Build evidence object",
  "x-invariants": [
    "integrity.payload_sha256 equals lowercase SHA-256 of the UTF-8 YAYA_CANONICAL_JSON_V1 encoding of payload",
    "when evidence_ref.sha256 is present it equals integrity.payload_sha256",
    "source.source_type = SKILL_BUILD and source.source_id = payload.build_id"
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_context",
    "evidence_ref",
    "subject",
    "source",
    "occurred_at",
    "recorded_at",
    "integrity",
    "payload",
    "related_evidence",
    "versions"
  ],
  "properties": {
    "request_context": { "$ref": "../common/request-context.schema.json" },
    "evidence_ref": { "$ref": "../common/evidence-ref.schema.json" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["learner_id"],
      "properties": {
        "learner_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_id", "command_id", "world_id"],
      "properties": {
        "source_type": { "const": "SKILL_BUILD" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "command_id": { "$ref": "../common/command-id.schema.json" },
        "world_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        }
      }
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_sha256", "previous_evidence_sha256"],
      "properties": {
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "previous_evidence_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        }
      }
    },
    "payload": { "$ref": "#/$defs/buildRejectionPayload" },
    "related_evidence": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "../common/evidence-ref.schema.json" }
    },
    "versions": { "$ref": "../common/version-set.schema.json" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "buildRejectionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "build_id", "skill_id", "test_suite_version", "outcome", "failure_stage", "failure_code", "diagnostic_codes"],
      "properties": {
        "evidence_kind": { "const": "BUILD_REJECTION" },
        "build_id": { "$ref": "#/$defs/identifier" },
        "skill_id": { "$ref": "#/$defs/identifier" },
        "test_suite_version": { "type": "string", "minLength": 1, "maxLength": 96 },
        "outcome": { "const": "REJECTED" },
        "failure_stage": { "type": "string", "minLength": 1, "maxLength": 64 },
        "failure_code": { "type": "string", "minLength": 1, "maxLength": 96 },
        "diagnostic_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 96 }
        }
      }
    }
  }
}
