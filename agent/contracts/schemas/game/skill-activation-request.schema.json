{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/game/skill-activation-request.schema.json",
  "title": "Activate certified skill version request",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_registry_revision", "activation_scope"],
  "properties": {
    "expected_registry_revision": {
      "type": "integer",
      "minimum": 0
    },
    "activation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_id", "agent_profile_id"],
      "properties": {
        "world_id": { "$ref": "#/$defs/identifier" },
        "agent_profile_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$"
    }
  }
}
