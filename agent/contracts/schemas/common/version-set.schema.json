{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/common/version-set.schema.json",
  "title": "VersionSet",
  "description": "Reproducibility versions pinned for one request or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "event_version",
    "policy_version",
    "world_rules_version",
    "teaching_spec_version"
  ],
  "properties": {
    "api_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "event_version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "world_rules_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "teaching_spec_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "skill_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "compiler_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "sandbox_image_digest": { "type": "string", "minLength": 1, "maxLength": 256 },
    "test_suite_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "prompt_version": { "type": "string", "minLength": 1, "maxLength": 96 },
    "model_version": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
