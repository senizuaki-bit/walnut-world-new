{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/feishu/report-job.schema.json",
  "title": "Feishu report draft job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "job",
    "draft_status",
    "delivery_status",
    "output_mode"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^rpt_[A-Za-z0-9_-]{8,128}$"
    },
    "job": {
      "$ref": "../common/async-job.schema.json"
    },
    "draft_status": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "GENERATING",
        "READY_FOR_REVIEW",
        "GENERATION_FAILED",
        "CANCELLED"
      ]
    },
    "delivery_status": {
      "const": "NOT_SENT"
    },
    "output_mode": {
      "const": "DRAFT_ONLY"
    },
    "draft_document_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/evidence-ref.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "draft_status": {
            "const": "READY_FOR_REVIEW"
          }
        },
        "required": [
          "draft_status"
        ]
      },
      "then": {
        "required": [
          "draft_document_ref",
          "evidence_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "job": {
            "properties": { "status": { "enum": ["ACCEPTED", "QUEUED"] } },
            "required": ["status"]
          }
        },
        "required": ["job"]
      },
      "then": { "properties": { "draft_status": { "const": "NOT_STARTED" } } }
    },
    {
      "if": {
        "properties": {
          "job": {
            "properties": { "status": { "const": "RUNNING" } },
            "required": ["status"]
          }
        },
        "required": ["job"]
      },
      "then": { "properties": { "draft_status": { "const": "GENERATING" } } }
    },
    {
      "if": {
        "properties": {
          "job": {
            "properties": { "status": { "const": "SUCCEEDED" } },
            "required": ["status"]
          }
        },
        "required": ["job"]
      },
      "then": { "properties": { "draft_status": { "const": "READY_FOR_REVIEW" } } }
    },
    {
      "if": {
        "properties": {
          "job": {
            "properties": { "status": { "const": "FAILED" } },
            "required": ["status"]
          }
        },
        "required": ["job"]
      },
      "then": { "properties": { "draft_status": { "const": "GENERATION_FAILED" } } }
    },
    {
      "if": {
        "properties": {
          "job": {
            "properties": { "status": { "const": "CANCELLED" } },
            "required": ["status"]
          }
        },
        "required": ["job"]
      },
      "then": { "properties": { "draft_status": { "const": "CANCELLED" } } }
    }
  ]
}
