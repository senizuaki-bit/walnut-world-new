{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.yaya.local/feishu/webhook-response.schema.json",
  "title": "Feishu webhook response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge"
      ],
      "properties": {
        "challenge": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "receipt_id",
        "disposition",
        "received_at",
        "trace_id"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^fwr_[A-Za-z0-9_-]{8,128}$"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "DUPLICATE",
            "QUARANTINED_UNSUPPORTED"
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^trace_[A-Za-z0-9_-]{8,96}$"
        },
        "quarantine_reason": {
          "type": "string",
          "maxLength": 512
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "QUARANTINED_UNSUPPORTED"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "quarantine_reason"
            ]
          }
        }
      ]
    }
  ]
}
